<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/linear1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#080D19"
    android:padding="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/textview1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ASTRO"
                android:textColor="#F3F7FF"
                android:textSize="27sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:gravity="center_vertical"
                android:paddingTop="10dp"
                android:paddingBottom="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="JAVA TOOLKIT  •  CONTROL CENTER"
                android:textColor="#7E91AD"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:paddingBottom="18dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#111C2E"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SESSION STATUS"
                    android:textColor="#45D9E8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10"
                    android:paddingBottom="8dp" />

                <TextView
                    android:id="@+id/textview5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ready when you are"
                    android:textColor="#EAF1FC"
                    android:textSize="14sp"
                    android:padding="10dp"
                    android:background="#0B1424"
                    android:gravity="center_vertical"
                    android:minHeight="44dp" />

                <TextView
                    android:id="@+id/textview9"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Progress: --"
                    android:textColor="#AAB9D0"
                    android:textSize="12sp"
                    android:paddingTop="10dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TARGET LIBRARY"
                android:textColor="#45D9E8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:paddingTop="22dp"
                android:paddingBottom="9dp" />

            <EditText
                android:id="@+id/edittext1"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Enter library name"
                android:singleLine="true"
                android:inputType="text"
                android:textColor="#F3F7FF"
                android:textColorHint="#71839F"
                android:textSize="14sp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:background="#111C2E" />

            <TextView
                android:id="@+id/textview3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TARGET LIB: --"
                android:textColor="#AAB9D0"
                android:textSize="12sp"
                android:paddingTop="8dp"
                android:paddingBottom="14dp" />

            <LinearLayout
                android:id="@+id/linear2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="#111C2E"
                android:padding="8dp">

                <Button
                    android:id="@+id/button1"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="LISTEN"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#07131E"
                    android:backgroundTint="#45D9E8" />

                <Button
                    android:id="@+id/button2"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="DONE"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#07131E"
                    android:backgroundTint="#9B8CFF" />
            </LinearLayout>

            <Button
                android:id="@+id/button5"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="RUN TOOL"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#07131E"
                android:backgroundTint="#45D9E8" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OUTPUT"
                android:textColor="#45D9E8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:paddingTop="22dp"
                android:paddingBottom="9dp" />

            <ScrollView
                android:id="@+id/vscroll1"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:background="#111C2E"
                android:padding="12dp"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/textview4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Output will appear here."
                    android:textColor="#DCE7F7"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="3dp" />
            </ScrollView>

            <TextView
                android:id="@+id/textview7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ACTIVITY LOG"
                android:textColor="#45D9E8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:paddingTop="18dp"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/textview8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HELP &amp; INFORMATION"
                android:textColor="#AAB9D0"
                android:textSize="12sp"
                android:lineSpacingExtra="4dp"
                android:background="#111C2E"
                android:padding="14dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
